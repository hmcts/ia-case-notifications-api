      {
        "reference": "1570_REQUEST_RESPONDENT_REVIEW_APPELLANT_AIP_EMAIL",
        "recipient": "{$TEST_CITIZEN_USERNAME}",
        "subject": "Immigration and Asylum appeal: The Home Office will review your appeal",
