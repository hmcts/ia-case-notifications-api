{
  "description": "RIA-4626 Send respondent review direction (AIP) - Home Office notification enabled",
  "disabled": "!{$featureFlag.homeOfficeGovNotifyEnabled}",
  "request": {
    "uri": "/asylum/ccdAboutToSubmit",
    "credentials": "CaseOfficer",
    "input": {
      "id": 1570,
      "eventId": "requestRespondentReview",
      "state": "reasonsForAppealSubmitted",
      "caseData": {
        "template": "aip-minimal-appeal-submitted.json",
        "replacements": {
          "homeOfficeReferenceNumber": "1212-0099-0062-8083",
          "subscriptions": [
            {
              "id": "1",
              "value": {
                "subscriber": "appellant",
                "email": "{$TEST_CITIZEN_USERNAME}",
                "wantsEmail": "Yes",
                "mobileNumber": "{$TEST_CITIZEN_MOBILE}",
                "wantsSms": "Yes"
              }
            }
          ],
          "directions": [
            {
              "id": "1",
              "value": {
                "explanation": "Review the built case",
                "parties": "respondent",
                "dateDue": "{$TODAY+14}",
                "dateSent": "{$TODAY}",
                "tag": "respondentReview"
              }
            }
          ],
          "hearingCentre": "taylorHouse"
        }
      }
    }
  },
  "expectation": {
    "status": 200,
    "errors": [],
    "caseData": {
      "template": "aip-minimal-appeal-submitted.json",
      "replacements": {
        "homeOfficeReferenceNumber": "1212-0099-0062-8083",
        "subscriptions": [
          {
            "id": "1",
            "value": {
              "subscriber": "appellant",
              "email": "{$TEST_CITIZEN_USERNAME}",
