        "body": [
          "PA/12345/2019",
          "1212-0099-0062-8083",
          "Pablo Jimenez",
          "PA/12345/2019",
          "{$iaExUiFrontendUrl}",
          "{$TODAY+14|d MMM yyyy}",
          "{$customerServices.telephoneNumber}",
          "{$customerServices.emailAddress}"        ]
