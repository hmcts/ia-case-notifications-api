              "mobileNumber": "{$TEST_CITIZEN_MOBILE}",
              "wantsSms": "Yes"
            }
          }
        ],
        "directions": [
          {
            "id": "1",
            "value": {
              "explanation": "Review the built case",
              "parties": "respondent",
              "dateDue": "{$TODAY+14}",
              "dateSent": "{$TODAY}",
              "tag": "respondentReview"
            }
          }
        ],
        "notificationsSent": [
          {
            "id": "1570_RESPONDENT_REVIEW_DIRECTION",
            "value": "$/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/"
          },
          {
            "id": "1570_REQUEST_RESPONDENT_REVIEW_APPELLANT_AIP_EMAIL",
            "value": "$/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/"
          },
          {
            "id": "1570_REQUEST_RESPONDENT_REVIEW_APPELLANT_AIP_SMS",
